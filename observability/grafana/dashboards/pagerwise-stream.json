   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - pagerwise:ingest_freshness:bad_ratio6h",
     "refId": "A"
    }
   ],
   "id": 4
  },
