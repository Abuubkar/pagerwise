{
 "uid": "pagerwise-stream",
 "title": "Pagerwise / Stream",
 "description": "Alert ingestion: Kafka lag, backpressure, outcomes, dead letters and ingest freshness (docs/slo.md).",
 "tags": [
  "pagerwise"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "links": [
  {
   "title": "SLOs",
   "url": "https://github.com/Abuubkar/pagerwise/blob/main/docs/slo.md",
   "type": "link"
  },
  {
   "title": "Alert runbooks",
   "url": "https://github.com/Abuubkar/pagerwise/blob/main/docs/alerts.md",
   "type": "link"
  }
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Stored alerts/s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(pagerwise_consumer_events_total{outcome=\"stored\"}[1m]))",
     "refId": "A"
    }
   ],
   "id": 1
  },
  {
   "type": "stat",
   "title": "alerts.v1 lag",
   "description": "End offset minus committed, summed over partitions. Alert: > 10k for 5m.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 10000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(max by (messaging_destination_partition_id) (pagerwise_consumer_lag{messaging_destination_name=\"alerts.v1\"}))",
     "refId": "A"
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Freshness p95",
   "description": "Alert: > 5 s for 10m.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
